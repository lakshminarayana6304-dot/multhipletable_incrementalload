										"type": "String"
									},
									"tablename": {
										"value": {
											"value": "@{item().tablename}",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_ASDB",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-10-16T05:08:59Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}